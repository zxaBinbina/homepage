# Optional local browser-tool endpoints. Copy to .env.local for local integration.
# Every VITE_* value is public in the browser bundle: never put credentials here.
VITE_BIN_API_ORIGIN=http://127.0.0.1:8787
VITE_BIN_BROWSE_ORIGIN=http://127.0.0.1:8787

# Optional independent Office viewer origin; must serve this build's /office-viewer/.
# Default production origin: https://homepage.zxabinbina.workers.dev
# Local preview automatically switches between localhost and 127.0.0.1.
# VITE_OFFICE_VIEWER_ORIGIN=https://homepage.zxabinbina.workers.dev
